# The wheel carries the runtime package; the sdist carries the same files plus
# packaging metadata. The development test suite is not installed with the
# package (its conftest is what makes the checkout layout importable), so
# shipping half of it in the sdist is worse than shipping none.
prune tests

# setuptools writes its egg-info metadata into the source tree before building
# the sdist. This drops the payload; setup.py drops the SOURCES.txt manifest
# that setuptools appends after MANIFEST.in has already been processed.
prune sutra_agent.egg-info
